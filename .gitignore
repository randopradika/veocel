# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and must be in the repo.
!.env.example

# vercel
.vercel

# Storyblok CLI working directory — a generated copy of storyblok/components.json.
# The canonical schema is the one under storyblok/. (CLI credentials live in
# ~/.storyblok, not here.)
.storyblok

# typescript
*.tsbuildinfo
next-env.d.ts
