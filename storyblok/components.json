      },
      "applications_label": {
        "type": "text",
        "description": "Label of the second spec row on every card. Defaults to 'key applications'."
      },
      "features_label": {
        "type": "text",
        "description": "Label of the third spec row on every card. Defaults to 'fiber features'."
      },
      "items": {
        "type": "bloks",
        "restrict_components": true,
        "component_whitelist": [
          "fiber_product_card"
        ]
      }
    }
  },
  {
    "name": "fiber_product_card",
    "display_name": "Fiber product card",
    "is_root": false,
    "is_nestable": true,
