      "heading": {
        "type": "text"
      },
      "intro": {
        "type": "textarea"
      },
      "items": {
        "type": "bloks",
        "restrict_components": true,
        "component_whitelist": [
          "product_card"
        ],
        "maximum": 6
      }
    }
  },
  {
    "name": "product_card",
    "display_name": "Product card",
    "is_root": false,
    "is_nestable": true,
    "schema": {
      "title": {
        "type": "text",
        "required": true
      },
      "image": {
        "type": "asset",
        "filetypes": [
          "images"
        ]
      },
      "link": {
        "type": "multilink"
      }
    }
  },
  {
    "name": "feature_split",
    "display_name": "Feature split",
    "is_root": false,
    "is_nestable": true,
    "schema": {
      "image": {
        "type": "asset",
        "filetypes": [
          "images"
        ]
      },
      "image_reveal": {
        "type": "asset",
        "filetypes": [
          "images"
        ],
        "description": "Optional 'after' image. When set, hovering the main image shows a magnifying lens revealing this one; touch and keyboard users toggle the full image instead."
      },
      "icon": {
        "type": "asset",
        "filetypes": [
          "images"
        ]
      },
      "heading": {
        "type": "text"
      },
      "body": {
        "type": "textarea"
      },
      "media_position": {
        "type": "option",
        "options": [
          {
            "name": "Image left",
            "value": "left"
          },
          {
            "name": "Image right",
            "value": "right"
          }
        ],
        "default_value": "left"
      }
    }
  },
  {
    "name": "feature_accordion",
    "display_name": "Feature accordion",
    "is_root": false,
    "is_nestable": true,
    "description": "Expandable items, one open at a time. The first opens by default.",
    "schema": {
      "heading": {
        "type": "text"
      },
      "layout": {
        "type": "option",
        "options": [
          {
            "name": "Tiles — three up, led by an icon",
            "value": "tiles"
          },
          {
            "name": "Cards — two up, led by a photograph",
            "value": "cards"
          },
          {
            "name": "Rows — full width, for long-form copy",
            "value": "rows"
          }
        ],
        "default_value": "tiles"
      },
      "items": {
        "type": "bloks",
        "restrict_components": true,
        "component_whitelist": [
          "accordion_item"
        ]
      }
    }
  },
  {
    "name": "accordion_item",
    "display_name": "Feature tile",
    "is_root": false,
    "is_nestable": true,
    "schema": {
      "title": {
        "type": "text",
        "required": true
      },
      "body": {
        "type": "textarea",
        "description": "Shown when the item is open. Leave a blank line to start a new paragraph."
      },
      "icon": {
        "type": "asset",
        "filetypes": [
          "images"
        ],
        "description": "Small mark. Used by the Tiles layout only."
      },
      "image": {
        "type": "asset",
        "filetypes": [
          "images"
        ],
        "description": "Photograph, roughly 12:5 landscape. Used by the Cards layout only."
      }
    }
  },
  {
    "name": "brand_strip",
    "display_name": "Brand strip",
    "is_root": false,
    "is_nestable": true,
    "description": "Scrolling retailer logos. Transparent PNG or SVG works best.",
