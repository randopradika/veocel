          "explore_tab"
        ],
        "maximum": 4
      }
    }
  },
  {
    "name": "explore_tab",
    "display_name": "Explore card",
    "is_root": false,
    "is_nestable": true,
    "schema": {
      "title": {
        "type": "text",
