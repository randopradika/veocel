      "heading": {
        "type": "text"
      },
      "logos": {
        "type": "multiasset",
        "filetypes": [
          "images"
        ]
      },
      "link_label": {
        "type": "text"
      },
      "link": {
        "type": "multilink"
      }
    }
  },
  {
    "name": "fiber_product_grid",
    "display_name": "Fiber product grid",
    "is_root": false,
    "is_nestable": true,
    "description": "A fiber family's catalogue: heading and intro side by side, then cards with photo, name and three spec rows.",
