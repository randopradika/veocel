[
  {
    "name": "page",
    "display_name": "Page",
    "is_root": true,
    "is_nestable": false,
    "schema": {
      "body": {
        "type": "bloks",
        "restrict_components": true,
        "component_whitelist": [
          "hero",
          "page_hero",
          "intro_section",
          "text_columns",
          "category_grid",
          "product_grid",
          "process_row",
          "image_banner",
          "feature_split",
          "feature_accordion",
          "explore_tabs",
          "news_list",
          "brand_strip",
          "fiber_type_grid",
          "fiber_product_grid",
          "certification_grid",
          "claim_grid",
          "cta_panel",
          "process_diagram",
          "fiber_portfolio",
          "brand_directory"
        ]
      },
      "seo_title": {
        "type": "text",
        "description": "Used verbatim as the browser title. Include the brand — nothing is appended."
      },
      "seo_description": {
        "type": "textarea",
        "max_length": 160
      }
    }
  },
  {
    "name": "config",
    "display_name": "Site configuration",
    "is_root": true,
    "is_nestable": false,
    "description": "Header, newsletter band and footer for the whole site. Must live at the slug 'config'.",
    "schema": {
      "main_nav": {
        "type": "bloks",
        "restrict_components": true,
        "component_whitelist": [
          "nav_item"
        ]
      },
      "utility_nav": {
        "type": "bloks",
        "restrict_components": true,
        "component_whitelist": [
          "nav_item"
        ],
        "maximum": 4
      },
      "newsletter_heading": {
        "type": "text"
      },
      "newsletter_placeholder": {
        "type": "text"
      },
      "newsletter_action_url": {
        "type": "text",
        "description": "Your email provider's form endpoint. Leave empty and the signup field stays disabled rather than discarding addresses."
      },
      "social_heading": {
        "type": "text"
      },
      "socials": {
        "type": "bloks",
        "restrict_components": true,
        "component_whitelist": [
          "social_link"
        ]
      },
      "responsibility_heading": {
        "type": "text",
        "description": "Heading of the band's third panel (\"social responsibility platform\")."
      },
      "responsibility_label": {
        "type": "text",
        "description": "Wordmark text of the third panel (\"ItsInOurHands\"). Leave empty to hide the panel."
      },
      "responsibility_link": {
        "type": "multilink"
      },
      "footer_tagline": {
        "type": "text"
      },
      "footer_columns": {
        "type": "bloks",
        "restrict_components": true,
        "component_whitelist": [
          "footer_column"
        ],
        "maximum": 4
      },
      "search_placeholder": {
        "type": "text",
        "description": "Placeholder on the footer search field. The form submits to the /search page."
      },
      "parent_logo": {
        "type": "asset",
        "filetypes": [
          "images"
        ],
        "description": "Parent-company mark (Lenzing) shown in the footer. Omitted when empty."
      },
      "parent_logo_link": {
        "type": "multilink"
      },
      "secondary_logo": {
        "type": "asset",
        "filetypes": [
          "images"
        ],
        "description": "Second mark next to the footer lockup (#ItsInOurHands). Omitted when empty."
      },
      "secondary_logo_link": {
        "type": "multilink"
      },
      "copyright": {
        "type": "text"
      },
      "legal_links": {
        "type": "bloks",
        "restrict_components": true,
        "component_whitelist": [
          "nav_item"
        ]
      }
    }
  },
  {
    "name": "nav_item",
    "display_name": "Navigation item",
    "is_root": false,
    "is_nestable": true,
    "schema": {
      "label": {
        "type": "text",
        "required": true
      },
      "link": {
        "type": "multilink"
      },
      "children": {
        "type": "bloks",
        "restrict_components": true,
        "component_whitelist": [
          "nav_item"
        ]
      }
    }
  },
  {
    "name": "footer_column",
    "display_name": "Footer column",
    "is_root": false,
    "is_nestable": true,
    "schema": {
      "title": {
        "type": "text"
      },
      "links": {
        "type": "bloks",
        "restrict_components": true,
        "component_whitelist": [
          "nav_item"
        ]
      }
    }
  },
  {
    "name": "social_link",
    "display_name": "Social link",
    "is_root": false,
    "is_nestable": true,
    "schema": {
      "platform": {
        "type": "option",
        "required": true,
        "options": [
          {
            "name": "LinkedIn",
            "value": "linkedin"
          },
          {
            "name": "Instagram",
            "value": "instagram"
          },
          {
            "name": "YouTube",
            "value": "youtube"
          },
          {
            "name": "Facebook",
            "value": "facebook"
          },
          {
            "name": "X",
            "value": "x"
          }
        ],
        "default_value": "linkedin"
      },
      "link": {
        "type": "multilink"
      }
    }
  },
  {
    "name": "hero",
    "display_name": "Hero",
    "is_root": false,
    "is_nestable": true,
    "description": "Full-bleed opening hero with a very large headline. One per page, first in the body.",
    "schema": {
      "eyebrow": {
        "type": "text"
      },
      "headline": {
        "type": "text",
        "required": true
      },
      "subline": {
        "type": "text"
      },
      "background_image": {
        "type": "asset",
        "filetypes": [
          "images"
        ]
      },
      "scroll_hint": {
        "type": "text"
      },
      "headline_size": {
        "type": "option",
        "options": [
          {
            "name": "Display — a word as the poster (home page)",
            "value": "display"
          },
          {
            "name": "Title — a section name (landing pages)",
            "value": "title"
          }
        ],
        "default_value": "display"
      },
      "align": {
        "type": "option",
        "options": [
          {
            "name": "Centred",
            "value": "center"
          },
          {
            "name": "Left — clears the right half for imagery",
            "value": "left"
          }
        ],
        "default_value": "center"
      },
      "nav_cards": {
        "type": "bloks",
        "restrict_components": true,
        "component_whitelist": [
          "hero_nav_card"
        ],
        "maximum": 8,
        "description": "Numbered shortcut cards pinned along the bottom of the hero."
      },
      "nav_placeholder": {
        "type": "text",
        "description": "What the phone-width dropdown says when no card matches the page (the home page). Defaults to 'select destination'."
      }
    }
  },
  {
    "name": "hero_nav_card",
    "display_name": "Hero nav card",
    "is_root": false,
    "is_nestable": true,
    "schema": {
      "label": {
        "type": "text",
        "required": true
      },
      "link": {
        "type": "multilink"
      }
    }
  },
  {
    "name": "intro_section",
    "display_name": "Intro section",
    "is_root": false,
    "is_nestable": true,
    "schema": {
      "heading": {
        "type": "text"
      },
      "body": {
        "type": "textarea"
      },
      "layout": {
        "type": "option",
        "options": [
          {
            "name": "Heading left, copy right",
            "value": "split"
          },
          {
            "name": "Stacked",
            "value": "stacked"
          }
        ],
        "default_value": "split"
      },
      "align": {
        "type": "option",
        "description": "Applies to the stacked layout only.",
        "options": [
          {
            "name": "Left",
            "value": "left"
          },
          {
            "name": "Centre",
            "value": "center"
          },
          {
            "name": "Right",
            "value": "right"
          }
        ],
        "default_value": "left"
      }
    }
  },
  {
    "name": "category_grid",
    "display_name": "Category grid",
    "is_root": false,
    "is_nestable": true,
    "schema": {
      "columns": {
        "type": "option",
        "options": [
          {
            "name": "Two",
            "value": "2"
          },
          {
            "name": "Three",
            "value": "3"
          },
          {
            "name": "Four",
            "value": "4"
          }
        ],
        "default_value": "2"
      },
      "items": {
        "type": "bloks",
        "restrict_components": true,
        "component_whitelist": [
          "category_card"
        ],
        "maximum": 8
      }
    }
  },
  {
    "name": "category_card",
    "display_name": "Category card",
    "is_root": false,
    "is_nestable": true,
    "schema": {
      "kicker": {
        "type": "text"
      },
      "title": {
        "type": "text",
        "required": true
      },
      "image": {
        "type": "asset",
        "filetypes": [
          "images"
        ]
      },
      "link": {
        "type": "multilink"
      }
    }
  },
  {
    "name": "process_row",
    "display_name": "Process row",
    "is_root": false,
    "is_nestable": true,
    "description": "Statement heading over a row of lifecycle steps.",
    "schema": {
      "heading": {
        "type": "text"
      },
      "align": {
        "type": "option",
        "options": [
          {
            "name": "Left",
            "value": "left"
          },
          {
            "name": "Centre",
            "value": "center"
          },
          {
            "name": "Right",
            "value": "right"
          }
        ],
        "default_value": "center"
      },
      "steps": {
        "type": "bloks",
        "restrict_components": true,
        "component_whitelist": [
          "process_step"
        ],
        "maximum": 6
      },
      "layout": {
        "type": "option",
        "options": [
          {
            "name": "Ring — circle of steps, copy beside",
            "value": "ring"
          },
          {
            "name": "Row — horizontal strip under the heading",
            "value": "row"
          }
        ],
        "default_value": "ring"
      },
      "diagram_image": {
        "type": "asset",
        "filetypes": [
          "images"
        ],
        "description": "Segmented-wheel artwork for the ring layout. Five wedges, matched to five steps in clockwise order from the top — the step titles are drawn over it as text. Leave empty to fall back to a circle of per-step images."
      },
      "body": {
        "type": "textarea",
        "description": "Copy shown beside the ring. Leave a blank line between paragraphs."
      },
      "link_label": {
        "type": "text"
      },
      "link": {
        "type": "multilink"
      }
    }
  },
  {
    "name": "process_step",
    "display_name": "Process step",
    "is_root": false,
    "is_nestable": true,
    "schema": {
      "title": {
        "type": "text",
        "required": true
      },
      "description": {
        "type": "textarea"
      },
      "image": {
        "type": "asset",
        "filetypes": [
          "images"
        ]
      }
    }
  },
  {
    "name": "image_banner",
    "display_name": "Image banner",
    "is_root": false,
    "is_nestable": true,
    "schema": {
      "image": {
        "type": "asset",
        "filetypes": [
          "images"
        ]
      },
      "title": {
        "type": "text"
      },
      "subtitle": {
        "type": "textarea"
      },
      "link_label": {
        "type": "text"
      },
      "link": {
        "type": "multilink"
      },
      "height": {
        "type": "option",
        "options": [
          {
            "name": "Medium",
            "value": "medium"
          },
          {
            "name": "Tall",
            "value": "tall"
          }
        ],
        "default_value": "medium"
      }
    }
  },
  {
    "name": "explore_tabs",
    "display_name": "Explore cards",
    "is_root": false,
