          "news_item"
        ]
      }
    }
  },
  {
    "name": "news_item",
    "display_name": "News item",
    "is_root": false,
    "is_nestable": true,
    "schema": {
      "category": {
        "type": "text"
      },
      "date": {
        "type": "datetime",
        "disable_time": true
      },
      "title": {
        "type": "text",
        "required": true
      },
      "image": {
        "type": "asset",
        "filetypes": [
          "images"
        ]
      },
      "link": {
        "type": "multilink"
      }
    }
  },
  {
    "name": "page_hero",
    "display_name": "Page hero",
    "is_root": false,
    "is_nestable": true,
    "description": "Shorter hero for category pages. Choose 'Dark' only when a hero image is set.",
    "schema": {
      "title": {
        "type": "text",
        "required": true
      },
      "subtitle": {
        "type": "textarea"
      },
      "image": {
        "type": "asset",
        "filetypes": [
          "images"
        ]
      },
      "theme": {
        "type": "option",
        "options": [
          {
            "name": "Dark — white type over photography",
            "value": "dark"
          },
          {
            "name": "Light — brand type on a tint",
            "value": "light"
          }
        ],
        "default_value": "dark"
      }
    }
  },
  {
    "name": "text_columns",
    "display_name": "Text columns",
    "is_root": false,
    "is_nestable": true,
    "schema": {
      "heading": {
        "type": "text"
      },
      "body": {
        "type": "textarea"
      },
      "align": {
        "type": "option",
        "options": [
          {
            "name": "Heading left, copy right",
            "value": "split"
          },
          {
            "name": "Centred heading, copy right",
            "value": "center"
          }
        ],
        "default_value": "split"
      }
    }
  },
  {
    "name": "product_grid",
