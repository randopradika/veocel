  {
    "name": "fiber_type_card",
    "display_name": "Fiber type card",
    "is_root": false,
    "is_nestable": true,
    "schema": {
      "title": {
        "type": "text",
        "required": true
      },
      "subtitle": {
        "type": "text",
        "description": "Smaller second line — the variant name, e.g. 'VEOCEL™ Viscostar - Hygiene*'."
      },
      "image": {
        "type": "asset",
        "filetypes": [
          "images"
        ],
        "description": "Landscape, roughly 16:9. Shown uncropped and without an overlay."
      },
      "link_label": {
        "type": "text",
        "description": "Button text. Defaults to 'explore' when empty."
      },
      "link": {
        "type": "multilink"
      }
    }
  },
  {
    "name": "certification_grid",
    "display_name": "Certification grid",
    "is_root": false,
    "is_nestable": true,
    "description": "Wall of certification marks, each on a white plate with a caption beneath.",
    "schema": {
      "heading": {
        "type": "text"
      },
      "intro": {
        "type": "textarea"
      },
      "align": {
        "type": "option",
        "options": [
          {
            "name": "Centred — the original wall",
            "value": "center"
          },
          {
            "name": "Left — ranged with the page's section headings",
            "value": "left"
