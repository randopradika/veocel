# Copy to `.env.local` (git-ignored) and fill in. Never commit real values.

# Storyblok content delivery token — Space Settings › Access Tokens.
# Use a "Preview" token so the Visual Editor can read drafts; published requests
# still ask for version=published explicitly.
#
# Leave this EMPTY to develop against the local mock content in `lib/mock/`:
# both designs render fully without a Storyblok space.
STORYBLOK_ACCESS_TOKEN=

# Shared secret guarding the Visual Editor entry point. Generate a long random
# string, then set the space's preview URL to:
#   https://<host>/api/draft?secret=<this value>&slug=
STORYBLOK_PREVIEW_SECRET=

# Shared secret for the publish webhook that busts the content cache:
#   https://<host>/api/revalidate?secret=<this value>
STORYBLOK_WEBHOOK_SECRET=
